<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- On Windows we need a windows TFM (>= 10.0.22000) to compile against the WinRT pen-haptics API
		     (PenDevice.SimpleHapticsController). Other OSes stay on plain net10.0. The TFM version is only
		     a build-time API ceiling — SupportedOSPlatformVersion (below) keeps the real minimum OS where
		     it was. Single TFM per OS, so existing `dotnet publish` (no -f) keeps working. -->
		<TargetFramework Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">net10.0-windows10.0.22000.0</TargetFramework>
		<TargetFramework Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' != 'true'">net10.0</TargetFramework>
		<ApplicationIcon>app.ico</ApplicationIcon>
		<StartupObject />
		<AssemblyName>Pix2d</AssemblyName>
		<EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
		<Version>$(Pix2dVersion)</Version>
		<PackageProjectUrl>https://pix2d.com</PackageProjectUrl>
    
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
		<RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;osx-x64;linux-x64;linux-arm64;</RuntimeIdentifiers>
		<UseSubFolderForOutputDirDuringMultiPlatformBuild>false</UseSubFolderForOutputDirDuringMultiPlatformBuild>
		<IsWindows Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">true</IsWindows>
		<IsOSX Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</IsOSX>
		<IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<PublishTrimmed>false</PublishTrimmed>
		<TrimMode>link</TrimMode>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	</PropertyGroup>
	<ItemGroup>
		<TrimmerRootDescriptor Include="LinkerConfig.xml" />
	</ItemGroup>
	<!-- Sentry crash telemetry DSN, injected at build time from the SENTRY_DSN env var / CI secret and
	     embedded as assembly metadata (read back via reflection by DesktopSentryCrashTelemetrySink).
	     Kept out of source; empty in local/dev builds, which makes the sink a no-op. -->
	<PropertyGroup>
		<SentryDsn Condition="'$(SentryDsn)' == '' and '$(SENTRY_DSN)' != ''">$(SENTRY_DSN)</SentryDsn>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SentryDsn</_Parameter1>
			<_Parameter2>$(SentryDsn)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
	<PropertyGroup Condition="'$(IsWindows)'=='true'">
		<DefineConstants>Windows</DefineConstants>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<!-- Keep the real minimum OS where it was; this is also the MinVersion build/pack-msix.ps1
		     stamps into the Store manifest's TargetDeviceFamily, so the two must agree. The pen
		     haptics code is gated at runtime with OperatingSystem.IsWindowsVersionAtLeast(10,0,22000), so
		     it stays dormant below Win11 and the app still launches on Win10. -->
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsOSX)'=='true'">
		<DefineConstants>OSX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsLinux)'=='true'">
		<DefineConstants>Linux</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsOSX)'=='true'">
		<CFBundleName>Pix2d</CFBundleName>
		<!-- Also defines .app file name -->
		<CFBundleDisplayName>Pix2d</CFBundleDisplayName>
		<CFBundleIdentifier>com.pix2d.app</CFBundleIdentifier>
		<CFBundleVersion>$(Pix2dVersion)</CFBundleVersion>
		<CFBundleShortVersionString>$(Pix2dVersion)</CFBundleShortVersionString>
		<CFBundlePackageType>APPL</CFBundlePackageType>
		<!--<CFBundleSignature>????</CFBundleSignature>-->
		<CFBundleExecutable>Pix2d</CFBundleExecutable>
		<CFBundleIconFile>Pix2d.png</CFBundleIconFile>
		<!-- Will be copied from output directory -->
		<NSPrincipalClass>NSApplication</NSPrincipalClass>
		<NSHighResolutionCapable>true</NSHighResolutionCapable>
		<UseAppHost>true</UseAppHost>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<RunAOTCompilation>true</RunAOTCompilation>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
		<PlatformTarget>ARM64</PlatformTarget>
		<RuntimeIdentifier>win-arm64</RuntimeIdentifier>
	</PropertyGroup>
	<ItemGroup>
		<Compile Update="**\*.xaml.cs">
			<DependentUpon>%(Filename)</DependentUpon>
		</Compile>
		<AvaloniaResource Include="**\*.xaml">
			<SubType>Designer</SubType>
		</AvaloniaResource>
	</ItemGroup>
	<ItemGroup>
	  <AvaloniaResource Remove="artifacts\**" />
	  <AvaloniaXaml Remove="artifacts\**" />
	  <Compile Remove="artifacts\**" />
	  <EmbeddedResource Remove="artifacts\**" />
	  <None Remove="artifacts\**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
		<PackageReference Include="Clowd.Clipboard" Version="1.1.4" />
		<PackageReference Include="Clowd.Clipboard.Gdi" Version="1.1.4" />
		<!-- Debug-only: pulls in the ASP.NET Core web stack + remote-control surface; must not ship in Release. -->
		<PackageReference Include="Declarative.Avalonia.AgentTools" Version="12.1.2-fix-agent.1" Condition="'$(Configuration)'=='Debug'" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Sentry" Version="6.5.0" />
		<!-- Pinned to match the version Avalonia.FreeDesktop (12.1.0) is compiled against. Pix2d has no
		     direct Tmds usage, but Avalonia's X11 backend loads Tmds.DBus.Protocol.Connection during
		     platform init on Linux. Bumping this ahead of Avalonia (e.g. 0.93.0) changed the Connection
		     type surface and threw TypeLoadException at startup on Linux — keep it in lockstep with Avalonia. -->
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Core\Pix2d.Shared\Pix2d.Shared.csproj" />
		<ProjectReference Include="..\..\Core\Pix2d.Core\Pix2d.Core.csproj" />
		<ProjectReference Include="..\..\Plugins\FormatSupport\Psd\Pix2d.Plugins.Psd\Pix2d.Plugins.Psd.csproj" />
		<ProjectReference Include="..\..\Plugins\Pix2d.Plugins.Ai\Pix2d.Plugins.Ai.csproj" />
	</ItemGroup>
</Project>