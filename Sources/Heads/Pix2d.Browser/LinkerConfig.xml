<linker>
	<!-- Rooting the Pix2d assemblies wholesale is deliberate: the declarative UI, the tool/view factories
	     (ActivatorUtilities), CommandsListBase's property reflection and NodeSerializer's Type.GetType all
	     resolve types by name at runtime, which the trimmer cannot follow. The size win comes from the BCL
	     and Avalonia instead. Do NOT list Pix2d.UI / Pix2d.Plugins.* here — those are namespaces inside
	     Pix2d.Core, not assemblies, and ILLink rejected them with IL2007 "Could not resolve assembly". -->
	<assembly fullname="Avalonia.Markup.Declarative" preserve="all" />
	<assembly fullname="Pix2d.Browser" preserve="all" />
	<assembly fullname="Pix2d.Core" preserve="all" />
	<assembly fullname="Pix2d.Infrastructure" preserve="all" />

	<assembly fullname="Newtonsoft.Json" preserve="all">
		<type fullname="Newtonsoft.Json.Linq.JObject" preserve="all" />
		<type fullname="Newtonsoft.Json.JsonConvert" preserve="all" />
		<type fullname="Newtonsoft.Json.JsonSerializer" preserve="all" />
		<type fullname="Newtonsoft.Json.JsonSerializerSettings" preserve="all" />
		<type fullname="Newtonsoft.Json.Serialization.DefaultContractResolver" preserve="all" />
		<type fullname="Newtonsoft.Json.Serialization.IContractResolver" preserve="all" />
	</assembly>

	<assembly fullname="SkiaNodes" preserve="all">
		<type fullname="SkiaNodes.Serialization.TypeNameAssemblyExcludingSerializationBinder" preserve="all" />
		<type fullname="SkiaNodes.SKNode" preserve="all" />
		<type fullname="SkiaNodes.Serialization.SKBitmapRef" preserve="all" />
	</assembly>

	<assembly fullname="Pix2d.Shared" preserve="all">
		<type fullname="Pix2d.CommonNodes.Pix2dSprite" preserve="all" />
		<type fullname="Pix2d.CommonNodes.Pix2dSprite+Layer" preserve="all" />
		<type fullname="Pix2d.CommonNodes.SpriteNode" preserve="all" />
	</assembly>

</linker>
