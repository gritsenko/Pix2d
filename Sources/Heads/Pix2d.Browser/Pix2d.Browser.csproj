<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
       <TargetFramework>net10.0-browser</TargetFramework>
		<RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
		<OutputType>Exe</OutputType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<TrimMode>link</TrimMode>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<!-- Untrimmed, the whole BCL shipped: 174 framework assemblies, 48.2 MB uncompressed / 16.7 MB
		     over the wire. Trimming takes that to 30.3 MB / 10.65 MB and 226 → 86 files. The Pix2d
		     assemblies are rooted preserve="all" in LinkerConfig.xml, so only the BCL and Avalonia
		     (which supports trimming) are actually reduced. -->
		<PublishTrimmed>true</PublishTrimmed>
		<WasmBuildNative>true</WasmBuildNative>
		<!-- Both properties only take effect once PublishTrimmed is on, but they must be set here or a
		     trimmed browser build breaks at runtime:
		     1. The WASM SDK bakes System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault=false into
		        a trimmed build's runtimeconfig, so every reflection-based JsonSerializer.Serialize/
		        Deserialize call throws InvalidOperationException. BrowserSettingsService (localStorage,
		        i.e. ALL settings) and CrashReportService's local report store use exactly those overloads,
		        and the Pix2d assemblies are rooted preserve="all" in LinkerConfig.xml, so the types
		        reflection needs are never trimmed away — re-enable it instead of hand-writing a
		        JsonSerializerContext for them.
		     2. UseSystemResourceKeys defaults to true when trimming, which replaces BCL exception
		        messages with bare resource keys and made the failure above unreadable in the console.
		        Pix2d.Droid already opts out for the same reason. -->
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<UseSystemResourceKeys>false</UseSystemResourceKeys>
	<!--<WasmEnableThreads>false</WasmEnableThreads>-->
	</PropertyGroup>
	<ItemGroup>
		<TrimmerRootDescriptor Include="LinkerConfig.xml" />
	</ItemGroup>
	<!-- Sentry DSN, injected at build time from the SENTRY_DSN env var / CI secret and embedded as
	     assembly metadata. WASM ships no Sentry crash SDK (no reliable browser-wasm support), but the
	     analytics track endpoint (stats.pix2d.com) is derived from this DSN host by AppStatEndpoint,
	     and AppStatTrackingClient is WASM-safe. Empty in local/dev builds → analytics stays disabled. -->
	<PropertyGroup>
		<SentryDsn Condition="'$(SentryDsn)' == '' and '$(SENTRY_DSN)' != ''">$(SENTRY_DSN)</SentryDsn>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SentryDsn</_Parameter1>
			<_Parameter2>$(SentryDsn)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<None Include="wwwroot\CNAME">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="wwwroot\CommonStuff.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="wwwroot\Splash.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia.Browser" Version="12.1.0" />
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
		<PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4" />
		<!--<PackageReference Include="Microsoft.NET.WebAssembly.Threading" Version="9.0.0-rc.2.24473.5" />-->
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="../../Core/Pix2d.Shared/Pix2d.Shared.csproj" />
		<ProjectReference Include="../../Core\Pix2d.Core\Pix2d.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Content Update="wwwroot\.gitattributes">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\.nojekyll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\app.css">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\favicon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\index.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\main.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
