<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
       <TargetFramework>net10.0-browser</TargetFramework>
		<RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
		<OutputType>Exe</OutputType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<TrimMode>link</TrimMode>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<PublishTrimmed>false</PublishTrimmed>
		<WasmBuildNative>true</WasmBuildNative>
	<!--<WasmEnableThreads>false</WasmEnableThreads>-->
	</PropertyGroup>
	<ItemGroup>
		<TrimmerRootDescriptor Include="LinkerConfig.xml" />
	</ItemGroup>
	<!-- Sentry DSN, injected at build time from the SENTRY_DSN env var / CI secret and embedded as
	     assembly metadata. WASM ships no Sentry crash SDK (no reliable browser-wasm support), but the
	     analytics track endpoint (stats.pix2d.com) is derived from this DSN host by AppStatEndpoint,
	     and AppStatTrackingClient is WASM-safe. Empty in local/dev builds → analytics stays disabled. -->
	<PropertyGroup>
		<SentryDsn Condition="'$(SentryDsn)' == '' and '$(SENTRY_DSN)' != ''">$(SENTRY_DSN)</SentryDsn>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SentryDsn</_Parameter1>
			<_Parameter2>$(SentryDsn)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<None Include="wwwroot\CNAME">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="wwwroot\CommonStuff.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="wwwroot\Splash.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia.Browser" Version="12.1.0" />
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
		<PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4" />
		<!--<PackageReference Include="Microsoft.NET.WebAssembly.Threading" Version="9.0.0-rc.2.24473.5" />-->
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="../../Core/Pix2d.Shared/Pix2d.Shared.csproj" />
		<ProjectReference Include="../../Core\Pix2d.Core\Pix2d.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Content Update="wwwroot\.gitattributes">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\.nojekyll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\app.css">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\favicon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\index.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\main.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="wwwroot\README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
